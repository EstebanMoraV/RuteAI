{
  "version": 2,
  "installCommand": "npm install -g pnpm@10.2.0 && cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @ruteai/core build",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
